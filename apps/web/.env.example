# Database. Omit locally to use the in-process dev PGlite (no Docker); set in production.
DATABASE_URL=

# LLM extraction — DeepSeek (OpenAI-compatible). Omit to use the deterministic rule-based fallback.
# Server-side only; never expose to the client.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
