# Database. Omit locally to use the in-process dev PGlite (no Docker); set in production.
DATABASE_URL=

# LLM — Claude first, then the OpenAI-compatible provider (DeepSeek / OpenRouter) as fallback.
# Omit both keys to use the deterministic rule-based fallback. Server-side only; never expose to the client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
