# Copy to deploy/.env on the server and fill in. NEVER commit the real .env.
# Postgres (isolated to this stack)
POSTGRES_USER=regenbazaar
POSTGRES_PASSWORD=change_me_strong_random
POSTGRES_DB=regenbazaar

# Host port for the web container (bound to 127.0.0.1 only). Pick a free port that does NOT
# collide with HelpRent (which uses 8002/8003). Verify first:  ss -tlnp | grep 8010
WEB_PORT=8010

# LLM extraction — DeepSeek (OpenAI-compatible). Leave empty to use the deterministic rule-based
# fallback. Server-side only; never exposed to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# IPFS read gateway (public URL we expose via nginx for resolving tRWI metadata CIDs).
IPFS_GATEWAY_URL=https://ipfs.regenbazaar.com

# On-chain (Celo Sepolia). OPERATOR_PRIVATE_KEY holds TOKENIZER+ATTESTER for attest/mint — server-only,
# never committed/in-browser; use a dedicated burner, keep admin offline. Filled after the W2 deploy.
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
OPERATOR_PRIVATE_KEY=

# Indexer (Ponder) — deployed contract addresses + the blocks they were deployed at.
TRWI_ADDRESS=0xa511F92336d9DcBe62caEA46F82DcaFa82BC3E65
TRWI_START_BLOCK=27205954
STAKING_ADDRESS=0x665C8964Be8cA3C1F429Aee75Ebe709FF67ef2C1
STAKING_START_BLOCK=27205954
