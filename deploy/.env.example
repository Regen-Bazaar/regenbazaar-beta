# Copy to deploy/.env on the server and fill in. NEVER commit the real .env.
# Postgres (isolated to this stack)
POSTGRES_USER=regenbazaar
POSTGRES_PASSWORD=change_me_strong_random
POSTGRES_DB=regenbazaar

# Host port for the web container (bound to 127.0.0.1 only). Pick a free port that does NOT
# collide with HelpRent (which uses 8002/8003). Verify first:  ss -tlnp | grep 8010
WEB_PORT=8010

# LLM extraction — DeepSeek (OpenAI-compatible). Leave empty to use the deterministic rule-based
# fallback. Server-side only; never exposed to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
