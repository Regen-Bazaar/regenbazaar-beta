# Copy to deploy/.env on the server and fill in. NEVER commit the real .env.
# Postgres (isolated to this stack)
POSTGRES_USER=regenbazaar
POSTGRES_PASSWORD=change_me_strong_random
POSTGRES_DB=regenbazaar

# Host port for the web container (bound to 127.0.0.1 only). Pick a FREE port — on the shared VPS
# 8000-8003 + 8010/8011 are taken (HelpRent/VitaCrypt/etc). Verify:  ss -tlnp | grep <port>
WEB_PORT=8012

# LLM extraction — DeepSeek (OpenAI-compatible). Leave empty to use the deterministic rule-based
# fallback. Server-side only; never exposed to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# IPFS read gateway (public URL we expose via nginx for resolving tRWI metadata CIDs).
IPFS_GATEWAY_URL=https://ipfs.regenbazaar.com

# On-chain network for this deployment: arbitrum-sepolia (default) | celo-sepolia. Baked into the web
# image at build time, so change it + rebuild. CHAIN_ID must match (421614 | 11142220).
NETWORK=arbitrum-sepolia
CHAIN_ID=421614
# Arbitrum Sepolia sale currency: empty = Paxos USDG; tUSDG = testnet stand-in (public mint) while the
# Paxos faucet is not dispensing.
SALE_CURRENCY=
# Optional provider RPC for server + indexer (public RPC is used if empty; it is rate-limited).
RPC_URL=

# OPERATOR_PRIVATE_KEY is the EAS attester + voucher signer. Server-only, never committed/in-browser;
# use a dedicated burner, keep admin offline.
OPERATOR_PRIVATE_KEY=

# Contract addresses for the indexer (see packages/contracts/deployments/<network>.json).
TRWI_ADDRESS=
TRWI_START_BLOCK=
STAKING_ADDRESS=
STAKING_START_BLOCK=
PRIMARY_SALE_ADDRESS=
# Bump when contracts/config change (Ponder will not reuse a schema from a different build).
INDEXER_SCHEMA=indexer_arbsep_v1
