# Regen Bazaar app (Arbitrum buildathon) -> regenbazaar_web on 127.0.0.1:8012. Separate from HelpRent/LP.
server {
    listen 80;
    listen [::]:80;
    server_name app.regenbazaar.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.regenbazaar.com;

    ssl_certificate /etc/letsencrypt/live/app.regenbazaar.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.regenbazaar.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Allow media uploads from the tokenize flow.
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8012;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
    }
}
