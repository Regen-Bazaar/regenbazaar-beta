# Copy to packages/contracts/.env (git-ignored) before deploying. NEVER commit real keys.

# Deployer = initial admin/tokenizer/attester. Use a TESTNET BURNER (the provided key was exposed in
# chat → testnet only, rotate before mainnet). Fund it with ~0.1+ CELO (deploy ships full EAS+Registry;
# this account also pays ongoing attest/mint gas as the operator).
DEPLOYER_PRIVATE_KEY=

# Celo Sepolia (chainId 11142220).
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# CeloScan API key for contract verification (Blockscout is a no-key fallback).
CELOSCAN_API_KEY=

# Arbitrum Sepolia (chainId 421614). Verification via Blockscout/Sourcify needs no key.
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optional.
# TREASURY_ADDRESS=        # receives REBAZ initial supply (defaults to deployer)
# REBAZ_INITIAL_SUPPLY=    # 18-decimals; default 0
# REWARD_RATE_BPS=1000     # staking base annual rate (default 10%)
# ALLOWED_CURRENCY=        # ERC-20 accepted by RegenPrimarySale, e.g. USDG on Arbitrum Sepolia
#                          # 0xFFC95faa3d63Cde504a05B567C600B78C0b41892
